$$-------------------------------------------------------$$
$$      Direct Text Input for Case Control
$$-------------------------------------------------------$$

TITLE = MovingLoad_Influence
SUBCASE 15
  SOL 101
  LABEL = Influence
  LOAD = 1 THRU 1002
  SPC = 1
  GEOPARM = 15
LINEARCOM 16
  SOL 2013
  LABEL = MovingInfluence
  SPC = 1
  GEOPARM = 16
  COMBINATIONPARAM = 16
  COMBINATIONCASES = 15
  DISPLACEMENT(PLOT) = ALL
  SPCFORCES(PLOT) = ALL
  FORCE(PLOT, CORNER) = 3
  VBARSEGFORCE(PLOT, CORNER) = 3
  STRESS(PLOT, CORNER) = 3
  VBARMULTISTRESS(PLOT, CORNER) = 3
  CONFORCE(PLOT, CORNER) = 3
  USE(MOVINGSPCINFO) = 16 (0, 25)

